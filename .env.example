# Compliance Platform local environment example
# Copy this file to .env and replace placeholders locally.
# Never commit .env or real API keys.

HOST=0.0.0.0
COMPLIANCE_PLATFORM_PORT=8766
DILIGENCE_DEMO_PORT=8767

# LLM provider settings. The Skill Runtime expects an OpenAI-compatible chat API.
LLM_PROVIDER=openai-compatible
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL_FAST=deepseek-v4-flash
LLM_MODEL_REASONING=deepseek-v4-pro
LLM_API_KEY=replace-with-your-api-key
LLM_MODEL=deepseek-v4-flash
LLM_TIMEOUT_SECONDS=120
LLM_MAX_OUTPUT_TOKENS=12000
LLM_TEMPERATURE=0

# Runtime storage
SKILL_RUNS_DIR=data/skill_runs
STRUCTURED_OUTPUTS_DIR=data/structured_outputs
SKILL_ARTIFACTS_DIR=data/skill_artifacts

# Optional future integrations
PKULAW_MCP_ENABLED=false
